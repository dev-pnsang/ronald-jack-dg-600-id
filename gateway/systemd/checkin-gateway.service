[Unit]
Description=CommaDesk Checkin Gateway (Ronald Jack DG-600-ID)
Documentation=file:///usr/share/doc/checkin-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=checkin-gateway
Group=checkin-gateway
ExecStart=/usr/bin/checkin-gateway --config /etc/checkin-gateway/checkin-gateway.conf --log-level info
Restart=on-failure
RestartSec=5
# Exit 2 = not enrolled yet — do not thrash restart
RestartPreventExitStatus=2
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/checkin-gateway
PrivateTmp=true

[Install]
WantedBy=multi-user.target
