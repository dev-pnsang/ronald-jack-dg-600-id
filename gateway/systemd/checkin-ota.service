[Unit]
Description=CommaDesk Checkin OTA agent
Documentation=file:///usr/share/doc/checkin-gateway/README.md
After=network-online.target
Wants=network-online.target
# Do NOT BindsTo/PartOf checkin-gateway — OTA must survive a bad gateway upgrade
# so the device can still pull a fixed package.

[Service]
Type=simple
User=root
ExecStart=/usr/bin/checkin-ota --config /etc/checkin-gateway/checkin-gateway.conf
Restart=on-failure
RestartSec=30
# Exit 2 = not enrolled yet — do not thrash restart
RestartPreventExitStatus=2
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
