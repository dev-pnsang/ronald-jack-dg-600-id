# Checkin Gateway — Ronald Jack DG-600-ID → CommaDesk device-ingest
# Copy to /etc/checkin-gateway/checkin-gateway.conf and edit.

# LAN connectivity to attendance terminal (NOT CommaDesk authentication)
device_ip=192.168.1.201
device_port=4370
device_password=0
device_timeout_sec=10

# CommaDesk API base (include /api/v1, no trailing slash)
base_url=https://your-host.example.com/api/v1

# Local state (credentials + outbox). Protect with filesystem permissions.
data_dir=/var/lib/checkin-gateway

agent_name=checkin-gateway
agent_version=1.2.0

# ATTLOG: gateway syncs twice daily at local 00:00 and 12:00 only,
# filtering punches from attendance_devices.usage_started_on; skips if fingerprint unchanged.
live_listen=true
# Also pull ATTLOG periodically (covers missed live events after reconnect)
poll_fallback=false
# Pull attendance_devices (with IP) from server and poll each terminal
discover_terminals=true
catalog_refresh_sec=300
poll_interval_sec=43200

# false = send local ID + all available fields; true = only attendance_code + timestamp
ingest_minimal=false

reconnect_delay_sec=5
outbox_retry_sec=15
outbox_max_attempts=50
outbox_retention_days=14
http_timeout_sec=30
